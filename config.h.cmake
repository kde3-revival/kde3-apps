/* config.h, generated by CMake from config.h.cmake.
 *
 * Only what the kdeutils sources test is defined here (see
 * ConfigureChecks.cmake); the autotools config.h also carried fallback
 * prototypes and portability blocks for systems that are not supported
 * any more.
 */

/* Name and version of package */
#define PACKAGE "kdeutils"
#define VERSION "@KDEUTILS_VERSION@"

/* ---- system ------------------------------------------------------- */

#cmakedefine HAVE_STDLIB_H 1

/* The size of `unsigned long', as computed by sizeof. */
#define SIZEOF_UNSIGNED_LONG @SIZEOF_UNSIGNED_LONG@

/* Define if the processor stores words with the most significant byte
   first (khexedit) */
#cmakedefine WORDS_BIGENDIAN 1

/* ---- kcalc -------------------------------------------------------- */

/* Define if you have libgmp */
#cmakedefine HAVE_GMP 1

#cmakedefine HAVE_IEEEFP_H 1

/* Define if you have support for long double in printf */
#cmakedefine HAVE_LONG_DOUBLE 1

/* Define if you have *l math functions (absl, ...) */
#cmakedefine HAVE_L_FUNCS 1

/* Define if you have isinf */
#cmakedefine HAVE_FUNC_ISINF 1

/* Define if you have round */
#cmakedefine HAVE_FUNC_ROUND 1

/* Define if you have roundl */
#cmakedefine HAVE_FUNC_ROUNDL 1
